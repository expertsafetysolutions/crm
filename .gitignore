# Database dumps from scripts/backup-db.js — full customer, staff and pricing records in
# plaintext JSON. Committing one would put the entire database into git history, where it
# survives every later deletion.
backups/
*.bson
*.gz

# Generated by scripts/setup-auto-backup.js and CONTAINS THE BACKUP PASSPHRASE in clear text —
# it is written to a file rather than passed as a scheduled-task argument because
# `schtasks /Query /V` prints arguments to any user who can list tasks.
scripts/run-nightly-backup.cmd
