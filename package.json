{
  "name": "expert-safety-crm-pwa",
  "version": "1.0.0",
  "description": "Expert Safety Solutions Full-Stack Field Service & CRM PWA",
  "scripts": {
    "start:server": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "test:workflow": "npm --prefix server run test:workflow",
    "verify": "node server/tests/verifyPhases.js",
    "keygen": "node scripts/generate-key.js",
    "encrypt:data": "node scripts/encrypt-existing-data.js",
    "decrypt:data": "node scripts/decrypt-existing-data.js",
    "verify:encryption": "node server/tests/verifyEncryption.js",
    "guide:staff": "node scripts/build-staff-guide.js",
    "backup:env": "node scripts/backup-env.js",
    "backup:full": "node scripts/backup-full.js",
    "verify:backup": "node scripts/verify-backup.js",
    "reset:auth": "node scripts/reset-auth.js",
    "backup": "node scripts/backup-db.js",
    "backup:secure": "node scripts/backup-db.js --gzip --encrypt",
    "backup:gzip": "node scripts/backup-db.js --gzip",
    "restore": "node scripts/restore-db.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.4",
    "nodemailer": "^6.10.1",
    "web-push": "^3.6.7"
  }
}
