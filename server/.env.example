# Copy to server/.env and fill in. Never commit the real .env — .gitignore excludes it.

# ── Required ──────────────────────────────────────────────────────────────────────────────────
# The server refuses to start without these two; there is no baked-in fallback by design.
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname
JWT_SECRET=a-long-random-string

PORT=5000

# ── Email (SMTP) ──────────────────────────────────────────────────────────────────────────────
# Host, port, user and from-address live in Quotation_Settings.smtp_config (editable in the app).
# Only the password lives here, under the name given by smtp_config.pass_ref (default SMTP_PASS).
# For Gmail this is a 16-character App Password, not the account password.
SMTP_PASS=

# ── SAFE MODE — read this before testing anything that sends ──────────────────────────────────
# Development points at the SAME database and the SAME live SMTP account as production, so a
# "test" dispatch reaches a real customer's inbox.
#
# Set this variable and every outgoing email is redirected to the address below instead, with a
# [SAFE MODE → original@address] subject prefix and a banner in the body saying who it was really
# for. WhatsApp is blocked outright — a Meta template carries no subject or banner, so a redirected
# one would be indistinguishable from a genuine message.
#
#   Local / testing : uncomment the line below
#   Production      : leave it OUT entirely (an empty value also counts as off)
#
# WARNING: if this is ever set on the production deployment, customers silently stop receiving
# quotations and invoices. The server prints a large warning banner at startup when it is active.
#
# MAIL_SAFE_MODE=expertsafetysolution@gmail.com

# ── WhatsApp Business Cloud API (optional) ────────────────────────────────────────────────────
# Everything else lives in Quotation_Settings.whatsapp_config; only the token is held here, under
# the name given by whatsapp_config.access_token_ref.
WHATSAPP_ACCESS_TOKEN=

# ── Web push (optional) ───────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Cron (recommended) ────────────────────────────────────────────────────────────────────────
# Guards /api/cron/*. Vercel sends it as `Authorization: Bearer $CRON_SECRET`.
# WHEN UNSET, THE CRON ROUTES ARE OPEN TO ANYONE ON THE INTERNET — and hitting one fans reminder
# emails out to every matching customer. Set the same value here and in the Vercel dashboard.
CRON_SECRET=

# ── Public base URL (optional) ────────────────────────────────────────────────────────────────
# Used to build customer-facing links (quotation portal, certificate QR verification). Vercel
# supplies VERCEL_URL automatically; set this to pin a custom domain instead.
PUBLIC_BASE_URL=

# ── Emergency access (leave EMPTY in normal operation) ───────────────────────────────────────
# The Staff_ID set here skips the new-device verification code entirely and can sign in from any
# browser with only its password.
#
# It exists for one situation: the OTP email cannot be delivered and nobody can get in. Verify a
# reset first — `npm run reset:auth -- --staff STAFF005 --confirm` clears lockouts, devices and
# pending codes straight from the database and needs no working login, which is the safer route.
#
# Set this ONLY while recovering, then clear it. An account named here is protected by its
# password alone.
AUTH_BREAK_GLASS_STAFF_ID=

# ── Field-level encryption (recommended) ─────────────────────────────────────────────────────
# AES-256-GCM encryption at rest for customer/staff contact fields (phone, address, email, bank
# details — see server/src/utils/encryptedFields.js for the exact list). Generate with:
#   npm run keygen
# 64 hex characters (32 bytes) — a passphrase is not accepted, only a raw key.
#
# WHEN UNSET, THESE FIELDS ARE STORED IN PLAINTEXT and the app runs exactly as before — this is
# opt-in so it can be rolled out without a forced migration. Once set, existing rows stay
# plaintext until migrated: run `npm run backup` then `npm run encrypt:data --confirm`.
#
# LOSING THIS KEY MEANS LOSING THE DATA — there is no recovery path. Keep a copy in a password
# manager, and set the SAME value in the Vercel project environment variables. Never rotate it
# without re-encrypting existing rows under the new key first.
FIELD_ENCRYPTION_KEY=

# ── Backup encryption (recommended) ──────────────────────────────────────────────────────────
# Powers `npm run backup:secure` (AES-256-GCM, scrypt-derived from this passphrase). Required
# only when backing up with --encrypt. At least 12 characters; longer is better since the file
# is what an attacker would have in hand for an offline guessing attempt.
BACKUP_PASSWORD=
