{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refilling-due-check",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/quotation-followup-check",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/payment-due-reminder-check",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/annual-prospect-check",
      "schedule": "30 4 * * *"
    }
  ]
}
